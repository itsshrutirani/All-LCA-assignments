   "source": [
    "#PAN Number Validation Using Regular Expression\n",
    "import re\n",
    "pan_num=input(\"Enter PAN Number:\")\n",
    "print(pan_num)\n",
    "pattern = r\"^[A-Z]{5}[0-9]{4}[A-Z]$\"\n",
    "\n",
    "if re.fullmatch(pattern, pan_num):\n",
    "    print(\"Valid PAN Number\")\n",
    "else:\n",
    "    print(\"Invalid PAN Number\")"
   ]
  },
